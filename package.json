{
  "name": "eventlaw",
  "version": "0.0.0",
  "description": "Executable temporal laws for event-driven TypeScript systems.",
  "author": "Luan Taraschi",
  "keywords": [
    "event-driven",
    "property-based-testing",
    "runtime-verification",
    "temporal-logic",
    "testing",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luantaraschi/eventlaw.git"
  },
  "bugs": {
    "url": "https://github.com/luantaraschi/eventlaw/issues"
  },
  "homepage": "https://github.com/luantaraschi/eventlaw#readme",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench:progress": "tsx bench/progress.ts",
    "example:lull": "tsx examples/lull.ts",
    "example:falsify": "tsx examples/falsify.ts",
    "example:webhooks": "tsx examples/webhooks.ts",
    "example:jsonl": "tsx examples/jsonl.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./fast-check": {
      "types": "./dist/fast-check.d.ts",
      "import": "./dist/fast-check.js",
      "require": "./dist/fast-check.cjs"
    },
    "./jsonl": {
      "types": "./dist/jsonl.d.ts",
      "import": "./dist/jsonl.js",
      "require": "./dist/jsonl.cjs"
    },
    "./opentelemetry": {
      "types": "./dist/opentelemetry.d.ts",
      "import": "./dist/opentelemetry.js",
      "require": "./dist/opentelemetry.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "peerDependencies": {
    "fast-check": ">=3 <5"
  },
  "peerDependenciesMeta": {
    "fast-check": {
      "optional": true
    }
  },
  "devDependencies": {
    "@luantaraschi/lull": "^0.3.0",
    "@types/node": "^22.0.0",
    "fast-check": "^4.3.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.0"
  }
}
